{
  "include": [
    {
      "id": "search_request",
      "desc": "검색을 요청하는 동사형: 검색해줘/검색해서/검색해봐/검색 좀/검색하고/검색한 뒤/서치해/구글링해",
      "pattern": "(검색|서치|구글링|웹\\s*서치)\\s*(좀\\s*)?(해|하여|하고|하여서|한\\s*(뒤|후|다음)|부탁)"
    },
    {
      "id": "search_by_means",
      "desc": "검색을 수단으로 지정: 검색으로 확인/검색을 통해/검색해서 얻은",
      "pattern": "(검색|서치|구글링)\\s*(으로|을\\s*통해|를\\s*통해)"
    },
    {
      "id": "web_source_lookup",
      "desc": "출처를 웹으로 지정한 조회: 인터넷에서 찾아/웹에서 확인/네이버로 알아봐",
      "pattern": "(웹|인터넷|온라인|구글|네이버|다음|빙)\\s*(에서|으로|로|에)\\s*(검색|찾|확인|조회|알아)"
    },
    {
      "id": "search_english_ko",
      "desc": "한국어 문장 속 영어 search 동사: search 해줘/search해서",
      "pattern": "\\b(search|google)\\s*(좀\\s*)?(해|하고|한\\s*(뒤|후))"
    }
  ],
  "exclude": [
    {
      "id": "search_as_feature",
      "desc": "검색이 구현·설명 대상(기능/엔진/알고리즘 등)인 경우",
      "pattern": "검색\\s*(엔진|알고리즘|기능|로직|창|바|박스|어\\s*자동완성|조건|필터|쿼리|인덱스|인덱싱|API|api|컴포넌트|페이지|최적화|속도|성능|모듈|서비스|시스템)\\s*(을|를|이|가|의|은|는)?\\s*(구현|개발|만들|설계|작성|개선|최적화|리팩터|수정|추가|설명|원리|비교|테스트|디버그)"
    },
    {
      "id": "search_algorithm",
      "desc": "자료구조·알고리즘 탐색 용어",
      "pattern": "(이진|이분|선형|순차|깊이\\s*우선|너비\\s*우선|binary|linear|DFS|BFS|dfs|bfs)\\s*(탐색|검색|search)"
    }
  ]
}
