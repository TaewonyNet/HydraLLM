# Server Configuration
PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# Cloud LLM API Keys (Comma separated for multiple keys)
# Get your keys at:
# Gemini: https://aistudio.google.com/app/apikey
# Groq: https://console.groq.com/keys
# Cerebras: https://cloud.cerebras.ai/
GEMINI_KEYS=your_gemini_key_1,your_gemini_key_2
GROQ_KEYS=your_groq_key
CEREBRAS_KEYS=your_cerebras_key

# Default Thresholds
MAX_TOKENS_FAST_MODEL=8192
# 요청 전체(공급자 재시도 포함) 마감 시간(초) - 클라이언트 무기한 대기 방지
REQUEST_DEADLINE_SECONDS=90

# Model Tier Overrides (Optional - Comma separated substrings)
FREE_MODELS=flash,lite,gpt-oss-120b,gpt-oss-20b,qwen3.8-27b,qwen-3.8-27b,ollama
PREMIUM_MODELS=pro,ultra,70b,gpt-4o

# Default Models for 'auto' routing
DEFAULT_FREE_MODEL=gemini-flash-latest
DEFAULT_PREMIUM_MODEL=gemini-pro-latest

# Scraping Configuration
DEFAULT_SCRAPE_MODE=standard  # standard, simple, network_only
ENABLE_CONTEXT_COMPRESSION=false

# Session Configuration
MAX_SESSIONS=50

# --- Automatic Routing Logic (Heuristics) ---
# When model is set to "auto", the gateway selects models based on these rules:
# 1. Multimodal Check: If images are present, Gemini (Vision) is prioritized.
# 2. Token-based Routing (single threshold = MAX_TOKENS_FAST_MODEL, default 8192):
#    - < MAX_TOKENS_FAST_MODEL: fast models (Groq / Cerebras, tier-aware)
#    - >= MAX_TOKENS_FAST_MODEL: Gemini (large context window)
# 3. Tier-Awareness: For Gemini, Pro is used ONLY if a premium key is available.
#    Otherwise, it falls back to Flash (Free but high context).
# 4. Web Search Fallback: If 'has_search' is True but no premium keys exist, 
#    the gateway uses its internal Playwright scraper to get real-time info.

# Local Agent Engines (Optional)
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENCODE_BASE_URL=http://localhost:4096/v1
OPENCLAW_BASE_URL=http://localhost:18789/v1

# Web Search Engines (Optional)
# 폴백 순서. 사용 가능: duckduckgo, bing, openserp (https://github.com/karust/openserp), searxng
# openserp 를 쓰려면 서버를 먼저 띄운다: openserp serve -a 127.0.0.1 -p 7000
SEARCH_PROVIDERS=duckduckgo,bing
# SEARCH_PROVIDERS=openserp,bing   # openserp 사용 시 권장 (README.ko.md 참고)
OPENSERP_BASE_URL=http://127.0.0.1:7000
# google | bing | duck | yandex | baidu | mega (mega = 여러 엔진 혼합, 결과 언어가 섞일 수 있음)
OPENSERP_ENGINE=duck
OPENSERP_LANG=
OPENSERP_TIMEOUT=30

# SearXNG (SEARCH_PROVIDERS 에 searxng 를 넣을 때). settings.yml 의 search.formats 에 json 필요
SEARXNG_BASE_URL=http://127.0.0.1:8890
SEARXNG_LANGUAGE=
SEARXNG_TIMEOUT=30

# Web Backend — inprocess(기본, 기존 동작) | mcp(검색 MCP 서버 호출)
# mcp 사용법: search_mcp/README.ko.md
WEB_BACKEND=inprocess
SEARCH_MCP_URL=http://127.0.0.1:8790/mcp
SEARCH_MCP_TIMEOUT=75
SEARCH_MCP_FALLBACK=true
SEARCH_MCP_TOKEN=
